{
  "name": "intentgraph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.check.json && tsc && vite build",
    "start": "node dist/index.js",
    "mcp:stdio": "tsx src/stdio.ts",
    "pay": "tsx scripts/pay.ts",
    "wallet:setup": "tsx scripts/setup-demo-wallet.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/core": "2.25.0",
    "@x402/hedera": "2.25.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "protobufjs": "8.8.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
