# Operator-only. Never supply this key to MCP users or put it in VITE_* variables.
GATEWAY_API_KEY=
HEDERA_SELLER_ACCOUNT_ID=
FACILITATOR_URL=https://api.testnet.blocky402.com
SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse
PRICE_TINYBARS=1000000
ACCESS_SECONDS=3600
QUERY_LIMIT=100
TOOL_CALL_LIMIT=500
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
MAX_SESSIONS=100
# Shared frontend playground; these keys never enter the browser bundle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_ENABLED=true
DEMO_DAILY_RUN_LIMIT=30
DEMO_MAX_STEPS=14
# Optional Hedera Portal personal access token for CLI faucet funding.
HEDERA_PAT=
# Comma-separated browser origins, if your landing page is hosted separately.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
